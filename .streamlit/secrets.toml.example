# Exemplo seguro para homologação OIDC/Keycloak.
# NÃO substitua os Secrets reais por este arquivo e NÃO coloque segredos aqui.
#
# Ative o fluxo somente no ambiente de homologação:
[auth]
homologacao = false

# URL absoluta da implantação de homologação + /oauth2callback.
redirect_uri = "https://SEU-ENDERECO-DE-HOMOLOGACAO/oauth2callback"

# Gere um segredo aleatório forte e cadastre somente no Secrets do Streamlit.
cookie_secret = "COLOQUE-NO-STREAMLIT-SECRETS"

# Valores fornecidos pelo Keycloak e mantidos somente no Secrets.
client_id = "gti-sesa-streamlit"
client_secret = "COLOQUE-NO-STREAMLIT-SECRETS"
server_metadata_url = "https://SEU-KEYCLOAK/realms/gti-sesa/.well-known/openid-configuration"

# Opcional: parâmetros OIDC não sensíveis.
# client_kwargs = { scope = "openid profile email", prompt = "login" }
